# Copy to .env and fill in values before running docker compose

# Generate with: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=

# Only needed once, to create the first Authentik admin (see Authentik docs)
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=

# --- Production only (infra/docker-compose.prod.yml) ---
# Left unset for local dev; the compose defaults (amsterfam/authentik) apply instead.
# Generated by Ansible (roles/app_deploy/templates/env.j2), not set by hand —
# shown here only for reference.
# POSTGRES_PASSWORD=
# AUTHENTIK_DB_PASSWORD=
# ACME_EMAIL=
# FRONTEND_DOMAIN=dev.amsterfam.eu
# API_DOMAIN=api.dev.amsterfam.eu
# AUTHENTIK_DOMAIN=a.dev.amsterfam.eu
# JWT_AUTHORITY=http://authentik:9000/application/o/amsterfam/
# JWT_ISSUER=https://a.dev.amsterfam.eu/application/o/amsterfam/
# OIDC_ISSUER=https://a.dev.amsterfam.eu/application/o/amsterfam/
# FRONTEND_ORIGIN=https://dev.amsterfam.eu
# BACKEND_IMAGE=ghcr.io/rgunti/amsterfam-backend
# BACKEND_IMAGE_TAG=<version>-<sha>
# FRONTEND_IMAGE=ghcr.io/rgunti/amsterfam-frontend
# FRONTEND_IMAGE_TAG=<version>-<sha>
