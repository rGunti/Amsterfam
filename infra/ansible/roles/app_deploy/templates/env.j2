# Managed by Ansible (roles/app_deploy) — do not edit by hand, changes will be overwritten.
AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}
AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_bootstrap_token }}
AUTHENTIK_BOOTSTRAP_EMAIL={{ authentik_bootstrap_email }}
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_bootstrap_password }}

POSTGRES_PASSWORD={{ postgres_password }}
AUTHENTIK_DB_PASSWORD={{ authentik_db_password }}

ACME_EMAIL={{ acme_email }}
FRONTEND_DOMAIN={{ frontend_domain }}
API_DOMAIN={{ api_domain }}
AUTHENTIK_DOMAIN={{ authentik_domain }}

JWT_AUTHORITY=http://authentik:9000/application/o/amsterfam/
JWT_ISSUER=https://{{ authentik_domain }}/application/o/amsterfam/

# Resolved by the frontend container at startup (see
# frontend/docker/render-config.sh) — the browser needs Authentik's public
# subdomain to log in, not the internal container network. API calls are
# proxied same-origin by the frontend's own nginx instead (see nginx.conf),
# so no equivalent value is needed for the API.
OIDC_ISSUER=https://{{ authentik_domain }}/application/o/amsterfam/

# Set explicitly by the Deploy workflow (--extra-vars) from the exact commit
# whose CI build succeeded — never re-derived here, so the code checked out
# above and the image pulled below are always the same commit.
BACKEND_IMAGE_TAG={{ backend_image_tag }}
FRONTEND_IMAGE_TAG={{ frontend_image_tag }}

# Allowed CORS origin for the API (browser calls come from the frontend's
# public origin, not the internal container network).
FRONTEND_ORIGIN=https://{{ frontend_domain }}
